<view style="padding: 30rpx;">
  <!-- 新增小组区域 -->
  <view style="background: white; padding: 30rpx; border-radius: 10rpx; margin-bottom: 30rpx;">
    <text style="font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 20rpx;">➕ 新增小组</text>
    <input 
      placeholder="请输入小组名称（如：技术部）" 
      bindinput="onGroupNameInput"
      style="border: 1px solid #eee; padding: 20rpx; border-radius: 10rpx; margin-bottom: 20rpx; font-size: 26rpx;"
      value="{{newGroupName}}"
    />
    <button 
      bindtap="addGroup"
      style="background: #4CAF50; color: white; font-size: 28rpx; padding: 20rpx; border-radius: 10rpx;"
    >
      确认添加
    </button>
  </view>

  <!-- 小组列表区域 -->
  <view style="background: white; padding: 30rpx; border-radius: 10rpx;">
    <text style="font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 20rpx;">📋 所有小组</text>
    <view wx:if="{{groupList.length === 0}}" style="text-align: center; padding: 50rpx; color: #999; font-size: 26rpx;">
      暂无小组数据，点击上方“新增小组”添加
    </view>
    <view wx:else>
      <!-- 循环展示所有小组 -->
      <view 
        wx:for="{{groupList}}" 
        wx:key="id"
        style="display: flex; justify-content: space-between; align-items: center; padding: 20rpx; border-bottom: 1px solid #eee;"
      >
        <text style="font-size: 26rpx;">{{item.group_name}}</text>
        <button 
          bindtap="deleteGroup"
          data-groupid="{{item.id}}"
          style="background: #f44336; color: white; font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 5rpx;"
        >
          删除
        </button>
      </view>
    </view>
  </view>
</view>