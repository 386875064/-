.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 标题区域 */
.title-area {
  text-align: center;
  margin-bottom: 80rpx;
  margin-top: 100rpx;
}

.main-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.sub-title {
  font-size: 28rpx;
  color: #666;
  display: block;
}

/* 打卡按钮 */
.btn-area {
  width: 100%;
  margin-bottom: 20rpx;
}

.checkin-btn {
  width: 100%;
  height: 120rpx;
  line-height: 120rpx;
  font-size: 36rpx;
  background-color: #4CAF50;
  color: white;
  border-radius: 20rpx;
  border: none;
}

.checkin-btn:active {
  background-color: #388E3C;
}

/* 查看全部打卡按钮 */
.others-checkin-area {
  width: 100%;
  margin-bottom: 60rpx;
}

.others-checkin-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FF9800;
  color: white;
  border-radius: 10rpx;
  border: none;
}

.others-checkin-btn:active {
  background-color: #F57C00;
}

/* 管理员区域 */
.admin-area {
  width: 100%;
  border-top: 1px solid #eee;
  padding-top: 40rpx;
}

.admin-title {
  font-size: 30rpx;
  color: #666;
  display: block;
  text-align: center;
  margin-bottom: 30rpx;
}

.admin-btn-group {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #2196F3;
  color: white;
  border-radius: 10rpx;
  border: none;
}

.admin-btn:active {
  background-color: #1976D2;
}