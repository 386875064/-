<view style="padding: 30rpx; background: #f5f5f5; min-height: 100vh;">
  <!-- 页面标题 -->
  <view style="text-align: center; margin-bottom: 30rpx;">
    <text style="font-size: 32rpx; font-weight: bold; color: #333;">📊 今日打卡统计</text>
    <text style="font-size: 24rpx; color: #999; display: block; margin-top: 10rpx;">{{todayDate}}</text>
  </view>

  <!-- 刷新按钮 -->
  <button 
    bindtap="refreshStatistics"
    style="background: #2196F3; color: white; font-size: 26rpx; padding: 15rpx; border-radius: 10rpx; margin-bottom: 30rpx;"
  >
    🔄 刷新统计数据
  </button>

  <!-- 统计列表（无数据提示） -->
  <view wx:if="{{statisticsList.length === 0}}" style="text-align: center; padding: 100rpx 0; background: white; border-radius: 10rpx;">
    <text style="font-size: 28rpx; color: #999;">暂无今日打卡数据</text>
  </view>

  <!-- 统计列表（有数据） -->
  <view wx:else>
    <view 
      wx:for="{{statisticsList}}" 
      wx:key="groupId"
      style="background: white; padding: 30rpx; border-radius: 10rpx; margin-bottom: 20rpx;"
    >
      <!-- 小组名称 -->
      <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
        <text style="font-size: 28rpx; font-weight: bold; color: #333;">{{item.groupName}}</text>
        <text style="font-size: 24rpx; color: #666;">打卡率：{{item.rate}}%</text>
      </view>

      <!-- 打卡数据 -->
      <view style="display: flex; justify-content: space-around; text-align: center;">
        <view>
          <text style="font-size: 36rpx; color: #4CAF50; font-weight: bold;">{{item.checkinCount}}</text>
          <text style="font-size: 22rpx; color: #999; display: block;">今日打卡人数</text>
        </view>
        <view style="width: 1px; background: #eee; height: 50rpx;"></view>
        <view>
          <text style="font-size: 36rpx; color: #f44336; font-weight: bold;">{{item.uncheckinCount}}</text>
          <text style="font-size: 22rpx; color: #999; display: block;">未打卡人数</text>
        </view>
      </view>

      <!-- 打卡名单（点击展开/收起） -->
      <view style="margin-top: 20rpx;">
        <button 
          bindtap="toggleCheckinList"
          data-groupid="{{item.groupId}}"
          style="background: #f9f9f9; color: #666; font-size: 24rpx; padding: 10rpx; border-radius: 5rpx;"
        >
          {{item.showList ? '收起打卡名单' : '查看打卡名单'}}
        </button>
        <view wx:if="{{item.showList}}" style="padding: 20rpx; background: #f9f9f9; border-radius: 5rpx; margin-top: 10rpx;">
          <text style="font-size: 24rpx; color: #666;">打卡用户OpenID：</text>
          <text wx:for="{{item.checkinOpenids}}" wx:key="*this" style="font-size: 22rpx; color: #333; display: block; margin-top: 5rpx;">
            • {{item}}
          </text>
        </view>
      </view>
    </view>
  </view>
</view>