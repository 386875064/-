<!-- 昵称输入 -->
<input placeholder="请输入昵称" bindinput="inputNickname" value="{{nickname}}" />

<!-- 小组名输入 -->
<input placeholder="请输入小组名" bindinput="inputGroupName" value="{{groupName}}" />

<!-- 可选：打卡文字 -->
<input placeholder="请输入打卡内容（可选）" bindinput="inputCheckinText" value="{{checkinText}}" />

<!-- 选择图片按钮 -->
<button bindtap="chooseImage">选择图片</button>

<!-- 录制音频按钮 -->
<button bindtap="recordAudio">录制音频</button>

<!-- 提交打卡按钮 -->
<button bindtap="submitCheckin" type="primary">提交打卡</button>

<!-- 预览选择的图片 -->
<view wx:for="{{imagePaths}}" wx:key="index">
  <image src="{{item}}" style="width: 100rpx; height: 100rpx;" />
</view>