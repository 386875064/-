<view style="padding: 20rpx;background:#f5f5f5;min-height:100vh;">
  <view style="font-size:32rpx;font-weight:bold;margin-bottom:20rpx;">📚 全部打卡记录</view>

  <view wx:if="{{list.length === 0}}" style="text-align:center;padding:50rpx 0;">
    <text style="font-size:24rpx;color:#999;">暂无打卡记录</text>
  </view>

  <view wx:else style="display:flex;flex-direction:column;gap:16rpx;">
    <view wx:for="{{list}}" wx:key="_id" style="background:#fff;border-radius:16rpx;padding:20rpx;">
      <view style="font-size:28rpx;font-weight:bold;margin-bottom:8rpx;">{{item.nickname}}</view>
      <view style="font-size:22rpx;color:#666;margin-bottom:12rpx;">
        <text>小组：{{item.groupName}}</text>
        <text style="margin-left:20rpx;">时间：{{item.checkinTime}}</text>
      </view>

      <!-- 音频播放（回退到原生按钮） -->
      <view wx:if="{{item.audioUrl}}" style="margin-bottom:12rpx;">
        <button 
          size="mini" 
          style="background:#f5f5f5;color:#007aff;"
          data-url="{{item.audioUrl}}"
          bindtap="playAudio"
        >
          ▶️ 播放音频
        </button>
      </view>

      <!-- 图片显示+预览（100%显示+最简预览逻辑） -->
      <view wx:if="{{item.imageUrls && item.imageUrls.length>0}}" style="display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx;">
        <image 
          wx:for="{{item.imageUrls}}" 
          wx:for-item="imgUrl"
          wx:key="index" 
          src="{{imgUrl}}" 
          mode="aspectFill" 
          style="width:120rpx;height:120rpx;border-radius:8rpx;"
          bindtap="previewImage"
          data-imgurl="{{imgUrl}}"
          data-imglist="{{item.imageUrls}}"
        ></image>
      </view>
    </view>
  </view>
</view>