<view style="padding: 20rpx; background: #f5f5f5; min-height: 100vh;">
  <view style="font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx;">👥 用户管理</view>

  <view wx:if="{{loading}}" style="text-align: center; padding: 50rpx 0;">
    <text style="font-size: 24rpx; color: #666;">加载用户列表中...</text>
  </view>

  <view wx:elif="{{userList.length === 0 && !loading}}" style="text-align: center; padding: 50rpx 0;">
    <text style="font-size: 24rpx; color: #999;">暂无用户数据</text>
  </view>

  <view wx:else>
    <view wx:for="{{userList}}" wx:key="_id" style="background:#fff; border-radius:16rpx; padding:24rpx; margin-bottom:16rpx;">
      
      <view style="font-size:30rpx; font-weight:bold;">{{item.nickname}}</view>
      <view style="color:#666; font-size:24rpx; margin-top:6rpx;">小组：{{item.groupName}}</view>
      <view style="color:#999; font-size:22rpx; margin-top:4rpx;">ID：{{item._id}}</view>

      <!-- 修改昵称 -->
      <view style="display:flex; gap:10rpx; margin-top:16rpx;">
        <input style="flex:1; border:1rpx solid #eee; border-radius:8rpx; padding:0 12rpx;" placeholder="新昵称" data-userid="{{item._id}}" bindinput="inputNewNickname" />
        <button size="mini" type="primary" data-userid="{{item._id}}" bindtap="updateNickname">保存昵称</button>
      </view>

      <!-- 修改小组 —— 选择已有小组，不是输入！！ -->
      <view style="display:flex; gap:10rpx; margin-top:12rpx;">
        <picker 
          mode="selector" 
          range="{{groupList}}" 
          data-userid="{{item._id}}"
          bindchange="onGroupChange"
          style="flex:1; border:1rpx solid #eee; border-radius:8rpx; padding:12rpx;"
        >
          <text>{{groupList[selectedGroupIndex[item._id]] || item.groupName}}</text>
        </picker>
        <button size="mini" style="background:#007aff;color:#fff" data-userid="{{item._id}}" bindtap="updateUserGroup">修改小组</button>
      </view>

      <!-- 删除用户 -->
      <view style="text-align:right; margin-top:16rpx;">
        <button size="mini" style="background:#ff3b30; color:#fff" data-userid="{{item._id}}" data-nickname="{{item.nickname}}" bindtap="deleteUser">删除用户</button>
      </view>

    </view>
  </view>
</view>